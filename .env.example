# ---------------------------------------------------------------------------
# CoolRoute Network Planner - environment
# The APP ITSELF NEEDS NONE OF THESE. Every interactive path reads the
# committed cache snapshot in /data. These keys are only used by the
# build-time scripts in /scripts (npm run data:*).
# ---------------------------------------------------------------------------

# FortyGuard - required by scripts/ingest-fortyguard.ts and scripts/credit-probe.ts
# Optional extra keys. Absent by default; everything works with just the first.
# A pool lets batch ingest and the interactive "fetch this tile" button draw on
# different quotas, and lets `npm run probe:keys` establish whether the
# filter_type and forecast-horizon limits are per-key or service-wide.
# FORTYGUARD_API_KEY_2=
# FORTYGUARD_API_KEY_3=

FORTYGUARD_API_KEY=
FORTYGUARD_BASE_URL=https://api.fortyguard.com

# OpenRouteService (preferred router; free key at openrouteservice.org/dev)
# Used by scripts/generate-routes.ts and, when set, by /api/route at runtime.
ORS_API_KEY=

# Optional: keyless public OSRM fallback used when ORS_API_KEY is absent.
OSRM_BASE_URL=https://router.project-osrm.org
